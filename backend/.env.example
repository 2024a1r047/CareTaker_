# ==============================================================================
# CareTaker Backend Environment Configuration (.env.example)
# Copy this file to .env and provide your specific credentials.
# Do NOT commit actual secrets or API keys to version control.
# ==============================================================================

# Core CareTaker Clinical PostgreSQL Database
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/caretaker

# Dedicated "Saathi" Conversational Memory PostgreSQL Database
SAATHI_DATABASE_URL=postgresql://postgres:your_password@localhost:5432/Saathi

# ElevenLabs Conversational AI & Voice Cloning Configuration
# Secret API key (starts with sk_...) - used ONLY on the backend to mint signed WebSocket URLs
ELEVENLABS_API_KEY=sk_your_elevenlabs_secret_api_key_here

# Cloned Voice ID (e.g., Asha - Soft Care Voice: VQxh7q9EH7jUlfwkQI00)
ELEVENLABS_VOICE_ID=VQxh7q9EH7jUlfwkQI00

# Conversational AI Agent ID (e.g., Saathi Agent: agent_0201m5wjypr0f46990bqwck3596g)
ELEVENLABS_AGENT_ID=agent_0201m5wjypr0f46990bqwck3596g

# Conversational Model
ELEVENLABS_MODEL_ID=eleven_v3_conversational

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=True
